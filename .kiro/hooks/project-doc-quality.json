{
  "version": "v1",
  "hooks": [
    {
      "name": "Project document quality gate",
      "description": "프로젝트 산출물 저장 후 필수 Evidence/Open Decision/Risk 구조를 검사한다.",
      "trigger": "PostFileSave",
      "matcher": "^docs/projects/.*\\.md$",
      "action": {"type": "command", "command": "pwsh -NoProfile -File scripts/quality-gate.ps1"},
      "timeout": 30,
      "enabled": true
    }
  ]
}
